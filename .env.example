# =====================================================================
# Modelo de configuração da API. Copie para .env e preencha.
#   cp .env.example .env
# =====================================================================

PORT=3000

# String de conexão do MongoDB Atlas.
# Atlas → Database → Connect → Drivers.
# Se a senha tiver caracteres especiais (@ : / ?), ela precisa ir
# codificada em percent-encoding, senão a URL quebra.
MONGODB_URI=mongodb+srv://usuario:senha@cluster.xxxxx.mongodb.net/pdv?retryWrites=true&w=majority

# Cloudinary — onde ficam as fotos dos produtos.
# Painel do Cloudinary → Dashboard → API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
